# Copy to .deploy.env and fill in your real values. .deploy.env is git-ignored —
# never commit it. ./deploy auto-sources it. See homelab/README.md for the
# contract these names follow.

# ssh destination for the NAS host itself.
NAS_SSH=deploy@nas.local
NAS_SSH_PORT=22

# This container's own address on the qnet macvlan — where the iOS Shortcut
# and curl reach it.
APP_LAN_IP=10.0.0.2

# The vault's own CouchDB — the same one Self-hosted LiveSync replicates
# against. Same address the other vault-writing apps already point at (see
# their own .deploy.env).
VAULT_LAN_IP=10.0.0.2

# The Mac running the ASR worker (~/projects/asr-server's speaches container).
# Required — transcription.backend is always remote (plan §1.4).
ASR_HOST=10.0.0.5

# Optional.
# NAS_APP_DIR=/share/Container/video-digest
# NAS_DOCKER_BIN=/share/CACHEDEV1_DATA/.qpkg/container-station/bin/docker
# NAS_PLATFORM=linux/amd64

# The Container Station macvlan network to join. Generated per NAS, so
# yours differs — find it with:  docker network ls | grep qnet
# QNET=qnet-static-eth1-000000
